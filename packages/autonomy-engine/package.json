{
  "name": "@vme/autonomy-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run --exclude=\"**/*postgres-genuine-integration*\"",
    "test:integration": "vitest run src/postgres-genuine-integration.test.ts",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@vme/agent-communication": "workspace:*",
    "@vme/agent-memory": "workspace:*",
    "@vme/department-hierarchy": "workspace:*",
    "@vme/orchestrator": "workspace:*",
    "@vme/performance-management": "workspace:*",
    "@vme/security-governance": "workspace:*",
    "@vme/shared-types": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.7.3"
  }
}
